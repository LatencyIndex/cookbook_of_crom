cabal-version:      3.6
name:               cookbook-of-crom
version:            0.1.0.0

-- A short (one-line) description of the package.
-- synopsis:

-- A longer description of the package.
-- description:

-- A URL where users can report bugs.
-- bug-reports:

-- The license under which the package is released.
-- license:
-- author:             Crom
-- maintainer:         Crom

-- A copyright notice.
-- copyright:
-- category:
extra-source-files: CHANGELOG.md

executable cookbook-of-crom
    main-is:          Main.hs
    -- Modules included in this executable, other than Main.
    other-modules:
        Crom.Diet
        Crom.Food
        Crom.Nutrients
        Crom.Recipes
        Crom.Shopping
        Crom.Time
        Crom.Units
        Crom.Units.Duration
        Crom.Units.Energy
        Crom.Units.Mass
        Crom.Units.Units
    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:
    default-extensions:
        OverloadedRecordDot
        -- Implicitly convert String literals to Data.Text
        OverloadedStrings
        DuplicateRecordFields
    build-depends:
        base,
        containers,
        text
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:
        -fwarn-tabs
        -fwarn-unused-imports
        -fwarn-missing-signatures
        -- -fwarn-name-shadowing
        -fwarn-incomplete-patterns
        -fwarn-overlapping-patterns
        -fwarn-incomplete-uni-patterns

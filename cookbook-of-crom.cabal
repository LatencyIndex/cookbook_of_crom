cabal-version:      3.6
name:               cookbook-of-crom
version:            0.1.0.0

synopsis: Evaluate & plan the nutrient content of your diet

author:             LatencyIndex
maintainer:         LatencyIndex

extra-source-files:
    LICENSE
    README.md

executable cookbook-of-crom
    main-is:          Main.hs
    other-modules:
        Crom.Calendar
        Crom.Diet
        Crom.Food
        Crom.FoodDB.Ingredients
        Crom.Nutrients
        Crom.Units
        Crom.Util.Functional
        Crom.Util.Text
        Ibis.Data.NTrie
        Ibis.JSON
        Ibis.JSON.Explore
    default-extensions:
        DuplicateRecordFields
        NoFieldSelectors
        OverloadedRecordDot
        OverloadedStrings
    build-depends:
        aeson,
        aeson-pretty,
        base,
        bytestring,
        conduit,
        conduit-aeson,
        containers,
        extra,
        text,
    hs-source-dirs:   src
    default-language: Haskell2010
    ghc-options:
        -Wall
        -Wunused-packages
